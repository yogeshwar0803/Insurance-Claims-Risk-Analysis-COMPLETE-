set.seed(123)

n_policies <- 1000

insurance_data <- data.frame(
  policy_id = 1:n_policies,
  exposure = runif(n_policies, 0.5, 1),
  claims_count = rpois(n_policies, lambda = 0.4)
)

# Generate claim severity only for policies with claims
severity <- rgamma(sum(insurance_data$claims_count),
                   shape = 2, scale = 15000)

insurance_data$claim_amount <- 0
insurance_data$claim_amount[insurance_data$claims_count > 0] <- severity
